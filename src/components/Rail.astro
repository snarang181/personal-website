---
import { site, nav } from '../data/site';

interface Props { home?: boolean }
const { home = false } = Astro.props;
const href = (id: string) => (home ? `#${id}` : `/#${id}`);
---

<aside class="rail">
  <div class="ident">
    {home
      ? <h1 class="boot">Samarth<br />Narang</h1>
      : <p class="name boot"><a href="/">Samarth<br />Narang</a></p>}
    <p class="role boot">{site.role}</p>
    <p class="blurb boot">{site.blurb}</p>
    <p class="where boot"><span class="pin"></span> {site.location}</p>
  </div>

  <nav class="pipe" aria-label="Sections">
    <span class="fill" aria-hidden="true"></span>
    <ol>
      {nav.map((s) => (
        <li>
          <a href={href(s.id)} data-nav={s.id}>{s.label} <span class="stage">{s.stage}</span></a>
        </li>
      ))}
    </ol>
  </nav>

  <div class="social">
    <a href={site.github} rel="me noopener" target="_blank">
      <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg>
      GitHub
    </a>
    <a href={`mailto:${site.email}`}>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="1.5" y="3" width="13" height="10" rx="1.5"/><path d="m2 4.5 6 4 6-4"/></svg>
      Email
    </a>
    <a href={site.blog}>
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="2" y="2" width="12" height="12" rx="1.5"/><path d="M5 6h6M5 9h6M5 12h3"/></svg>
      Tiled Thoughts
    </a>
  </div>
</aside>
